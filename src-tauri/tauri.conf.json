{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "待办列表",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true
      },
      "path": {
        "all": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.todo.list",
      "longDescription": "一款简洁高效的待办列表应用，支持悬浮面板、定时提醒和本地数据持久化",
      "resources": [],
      "shortDescription": "待办列表",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "label": "main",
        "title": "待办列表",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false,
        "url": "index.html"
      },
      {
        "label": "float",
        "title": "待办列表 - 悬浮面板",
        "width": 380,
        "height": 520,
        "resizable": false,
        "fullscreen": false,
        "decorations": true,
        "visible": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "url": "float.html"
      }
    ]
  }
}
