{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build:front",
    "devPath": "../src-react/dist",
    "distDir": "../src-react/dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Kettd",
    "version": "2.2.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "fs": {
        "all": true,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "createDir": true
      },
      "path": {
        "all": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.todo.list",
      "longDescription": "一款简洁高效的本地待办应用，支持待办、多便签、定时提醒和本地数据持久化",
      "resources": [],
      "shortDescription": "Kettd",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "wix": {
          "language": "zh-CN"
        }
      }
    },
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/32x32.png"
    },
    "updater": {
      "active": false
    },
    "windows": []
  }
}
